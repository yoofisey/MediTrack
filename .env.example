# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Payment (required for production)
NEXT_PUBLIC_PAYSTACK_KEY=pk_live_xxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Multi-country Paystack (Ghana live; Nigeria/ZA/Kenya activate when configured).
# Each market uses its own Paystack merchant account, so it needs its own public
# key, secret key, and plan codes. Leave unset (or plan codes empty) to show
# "coming soon" for that country.
# NEXT_PUBLIC_PAYSTACK_KEY_NG=pk_live_xxxxxxxxxx
# NEXT_PUBLIC_PAYSTACK_KEY_ZA=pk_live_xxxxxxxxxx
# NEXT_PUBLIC_PAYSTACK_KEY_KE=pk_live_xxxxxxxxxx
# PAYSTACK_SECRET_KEY_NG=sk_live_xxxxxxxxxx
# PAYSTACK_SECRET_KEY_ZA=sk_live_xxxxxxxxxx
# PAYSTACK_SECRET_KEY_KE=sk_live_xxxxxxxxxx
# Plan codes are PUBLIC (shown in checkout), so they use the NEXT_PUBLIC_ prefix.
# NEXT_PUBLIC_PAYSTACK_PLAN_PRO_NG=PLN_xxxxxxxxxx
# NEXT_PUBLIC_PAYSTACK_PLAN_FAMILY_NG=PLN_xxxxxxxxxx
# NEXT_PUBLIC_PAYSTACK_PLAN_PRO_ZA=PLN_xxxxxxxxxx
# NEXT_PUBLIC_PAYSTACK_PLAN_FAMILY_ZA=PLN_xxxxxxxxxx
# NEXT_PUBLIC_PAYSTACK_PLAN_PRO_KE=PLN_xxxxxxxxxx
# NEXT_PUBLIC_PAYSTACK_PLAN_FAMILY_KE=PLN_xxxxxxxxxx

# Web Push VAPID keys (for server-side notifications)
NEXT_PUBLIC_VAPID_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Invite emails (Resend)
RESEND_API_KEY=re_xxxxxxxxxx

# Guard for the Vercel cron endpoint (/api/cron/send-reminders)
CRON_SECRET=your-random-secret

# Canonical app origin (invite accept links, etc.)
NEXT_PUBLIC_APP_URL=https://www.useadhera.com

# Capacitor WebView override (leave unset for production)
# CAPACITOR_SERVER_URL=https://www.useadhera.com

# Site URL (used for OAuth redirects & OG tags)
NEXT_PUBLIC_SITE_URL=https://www.useadhera.com

# Firebase Cloud Messaging (for native push on Android/iOS)
# Base64-encoded Firebase service account JSON key
FIREBASE_SERVICE_ACCOUNT_JSON=your-base64-service-account-json
FCM_PROJECT_ID=your-firebase-project-id

# Error monitoring (Sentry) — optional. If unset, the SDK no-ops and the
# app builds/runs normally. Create a project at https://sentry.io.
# Public DSN visible to the browser; used to init the client SDK.
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000
# Server/edge DSN (fallback for server-side init).
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000
# Org/project slugs + auth token for source-map upload (CI/prod builds only).
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_eyJxxxxxxxx
