# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# android ide
android/.idea/

# firebase google services (injected by CI, contains client API key)
android/app/google-services.json

# local test harness
/_verify_push.mjs
/_dbg_push.mjs
/_verify_medid.mjs
/_verify_push_live.mjs

android/build_log.txt

# local signing secrets
keystore.properties
*.jks
keystore.jks

.env*
